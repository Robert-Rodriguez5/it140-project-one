# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

SET game_not_over = TRUE
WHILE game_not_over = TRUE
    SET current_room = player's current room
    SET movement_command = direction the player wants to move

    PUT "Enter a direction (north, south, east, or west):"
    GET movement_command

    SET valid_move = FALSE

    IF current_room = "Foyer" AND movement_command = "west"
        SET valid_move = TRUE
    ELSE IF current_room = "Foyer" AND movement_command = "north"
        SET valid_move = TRUE
    ELSE IF current_room = "Bedroom" AND movement_command = "east"
        SET valid_move = TRUE
    ELSE IF current_room = "Bedroom" AND movement_command = "north"
     SET valid_move = TRUE
    ELSE IF current_room = "Attic" AND movement_command = "south"
        SET valid_move = TRUE
    ELSE IF current_room = "Attic" AND movement_command = "north"
        SET valid_move = TRUE
    ELSE IF current_room = "Library" AND movement_command = "south"
        SET valid_move = TRUE
    ELSE IF current_room = "Library" AND movement_command = "east"
        SET valid_move = TRUE
    ELSE IF current_room = "Study" AND movement_command = "west"
        SET valid_move = TRUE
    ELSE IF current_room = "Study" AND movement_command = "east"
        SET valid_move = TRUE
    ELSE IF current_room = "Kitchen" AND movement_command = "west"
        SET valid_move = TRUE
    ELSE IF current_room = "Kitchen" AND movement_command = "south"
        SET valid_move = TRUE
    ELSE IF current_room = "Garage" AND movement_command = "north"
        SET valid_move = TRUE
    ELSE IF current_room = "Garage" AND movement_command = "west"
        SET valid_move = TRUE
    ELSE IF current_room = "Basement" AND movement_command = "east"
        SET valid_move = TRUE
    ELSE IF current_room = "Basement" AND movement_command = "south"
        SET valid_move = TRUE
    ENDIF

    IF valid_move = TRUE
    IF current_room = "Foyer" AND movement_command = "west"
        SET current_room = "Bedroom"
    ELSE IF current_room = "Foyer" AND movement_command = "north"
        SET current_room = " Basement"
    ELSE IF current_room = "Bedroom" AND movement_command = "east"
        SET current_room = "Foyer"
    ELSE IF current_room = "Bedroom" AND movement_command = "north"
        SET current_room = "Attic"
    ELSE IF current_room = "Attic" AND movement_command = "south"
        SET current_room = "Bedroom"
    ELSE IF current_room = "Attic" AND movement_command = "north"
        SET current_room = "Library"
    ELSE IF current_room = "Library" AND movement_command = "south"
        SET current_room = "Attic"
    ELSE IF current_room = "Library" AND movement_command = "east"
        SET current_room = "Study"
    ELSE IF current_room = "Study" AND movement_command = "west"
        SET current_room = "Library"
    ELSE IF current_room = "Study" AND movement_command = "east"
        SET current_room = "Kitchen"
    ELSE IF current_room = "Kitchen" AND movement_command = "west"
        SET current_room = "Study"
    ELSE IF current_room = "Kitchen" AND movement_command = "south"
        SET current_room = "Garage"
    ELSE IF current_room = "Garage" AND movement_command = "north"
        SET current_room = "Kitchen"
    ELSE IF current_room = "Garage" AND movement_command = "west"
        SET current_room = "Basement" 
    ELSE IF current_room = "Basement" AND movement_command = "east"
        SET current_room = "Garage"
    ELSE IF current_room = "Basement" AND movement_command = "south"
        Set current_room = "Foyer"
        ENDIF
        PUT "You moved to " + current_room + "."
    ENDIF

    IF valid_move = FALSE
        PUT "You cannot move in that direction."
    ENDIF

    IF current_room = "Foyer" AND inventory contains all six items
        PUT "You escaped the mansion!"
        SET game_not_over = FALSE
    ELS IF player is in the same room as ghost
        Put "The ghost caught you!"
        SET game_not_over = FALSE
    ENDIF
ENDWHILE
